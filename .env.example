# Copy to .env for local development. Vite inlines these at BUILD time, so for
# the deployed site they must be set as GitHub Actions repository secrets — a
# .env file here has no effect on production. See README.md → Deployment.
#
# The anon key is public by design: it ships inside the client bundle and is
# protected by row-level security, not secrecy. Copy it from
# Supabase → Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_URL=https://xgpdfefxarllgykjbppn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
